# Provedor de LLM usado para extrair endereço do campo "Observação".
# Valores aceitos: groq | gemini
LLM_PROVIDER=groq

# Necessária se LLM_PROVIDER=groq (grátis em https://console.groq.com)
GROQ_API_KEY=

# Necessária se LLM_PROVIDER=gemini (grátis em https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Origens permitidas para CORS (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Tamanho máximo do PDF de orçamento aceito no upload, em MB
MAX_UPLOAD_MB=10

# Limite de requisições por IP nos endpoints sensíveis (upload/geração)
RATE_LIMIT=20/minute
